# memo embed TEXT [--compare-to TEXT] [--json] — what the configured embedder makes of
# a text: its model and vector size (and, with --compare-to, how similar two texts
# are); --json adds the vector itself.
cmd_embed() {
    require_jq
    local text="${1:-}"
    [[ -n "$text" && "$text" != --* ]] || {
        echo "usage: memo embed TEXT [--compare-to TEXT] [--json]" >&2; exit 2; }
    shift
    local json full=false
    json=$(jq -n --arg t "$text" '{text: $t}')
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --compare-to)
                [[ $# -ge 2 ]] || { echo "memo embed: --compare-to needs a text" >&2; exit 2; }
                json=$(jq --arg v "$2" '. + {compare_to: $v}' <<<"$json"); shift 2 ;;
            --json) full=true; json=$(jq '. + {vector: true}' <<<"$json"); shift ;;
            *) echo "usage: memo embed TEXT [--compare-to TEXT] [--json]" >&2; exit 2 ;;
        esac
    done
    local out; out=$(printf '%s' "$json" | api_call embed)
    if [[ "$full" == true ]] || ! jq -e '.ok == true' <<<"$out" >/dev/null; then
        jq . <<<"$out"
    else
        jq -r '"embedder: \(.embedder)\(if .model then " (" + .model + ")" else "" end)\ndimension: \(.dim)"
               + (if .truncated then "\ntruncated: the text was cut to fit the embedder" else "" end)
               + (if .cosine then "\ncosine similarity: \(.cosine * 10000 | round / 10000)" else "" end)' <<<"$out"
    fi
    jq -e '.ok == true' <<<"$out" >/dev/null
}

# memo tune-weights [--scope S] [--samples N] [--metric M] [--json] — which
# MEMO_HYBRID_WEIGHTS blend finds this scope's memories best: each sampled memory is
# searched for by its own title at every blend (luamemo.tune_weights). It reports;
# applying the result is `memo config set` (the command it prints).
cmd_tune_weights() {
    require_jq
    local json full=false
    local usage="usage: memo tune-weights [--scope SCOPE] [--samples N] [--metric r_at_1|r_at_3|r_at_5|r_at_10|mrr] [--json]"
    json=$(jq -n --arg s "${MEMO_SCOPE:-}" 'if $s == "" then {} else {scope: $s} end')
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope|--samples|--metric)
                [[ $# -ge 2 ]] || { echo "memo tune-weights: $1 needs a value" >&2; exit 2; }
                json=$(jq --arg k "${1#--}" --arg v "$2" '. + {($k): $v}' <<<"$json"); shift 2 ;;
            --json) full=true; shift ;;
            -h|--help) echo "$usage"; return 0 ;;
            *) echo "$usage" >&2; exit 2 ;;
        esac
    done
