#!/usr/bin/env bash
# memo — luamemo CLI: persistent semantic memory for AI agents.
#
# Stores and retrieves memories in a local SQLite database (one file per
# project, in ~/.local/share/luamemo) using hybrid vector + full-text search.
# Supports pluggable embedders (in-process GGUF, Ollama, OpenAI, TEI, built-in
# hash), knowledge graphs, encrypted secrets, memory tiers (0–3), a whole-repo
# codebase index (memo index), and an MCP stdio server so AI agents can read/write
# memory and query the code map directly. Needs LuaJIT, libsqlite3 and libsodium —
# no database server.
#
# Configuration: MEMO_* settings (`memo config list` shows every one), from the
# environment, ~/.luamemorc (every project) and the project's .luamemorc (written by
# `memo calibrate` and `memo config set`) — a later one wins:
#   MEMO_DB       The database: a name (a file in $XDG_DATA_HOME/luamemo, default
#                 ~/.local/share/luamemo) or a path. calibrate gives each project
#                 its own.
#   MEMO_LUA      The LuaJIT interpreter to run (name or path). Default: luajit.
#   MEMO_PROJECT  The project directory whose .luamemorc memo reads and writes
#                 (calibrate --root / mcp --project win over it). Default (unset or
#                 empty): the nearest directory from here up that holds a
#                 .luamemorc, else the current one.
#
# Commands:
#   memo write      --scope SCOPE --kind KIND --title T --body B [--tags a,b,c]
#                   [--metadata JSON] [--importance F] [--decay-rate F]
#                   [--dedup-strategy update|skip|append] [--created-at ISO|EPOCH] [--tier 0-3]
#
#   memo search     QUERY [--scope SCOPE | --scopes a,b] [--kind KIND] [--limit N]
#                         [--since ISO|EPOCH] [--until ISO|EPOCH]
#                         [--tier-min N] [--tier-max N] [--ignore-decay 1]
#                         [--metadata-filter JSON] [--min-score F] [--rerank on|off]
#                         [--hybrid-weights '{"vector":F,"fts":F}'] [--project P]
#
#   memo recent     [--scope SCOPE] [--kind KIND] [--limit N] [--offset N]
#
#   memo get        ID
#
#   memo update     ID [--title T] [--body B] [--scope S] [--kind K] [--tags a,b]
#                   [--metadata JSON] [--importance F] [--decay-rate F]
#
#   memo delete     ID | --scope SCOPE [--kind KIND] [--meta JSON] [--yes]
#                   (by filter: how many match and a few titles; --yes deletes them —
#                    an org replica / org directives are never matched)
#
#   memo context    QUERY [--scope SCOPE] [--limit N] [--no-kg] [--format text|json]
#                   (search + KG facts in one call, formatted for agent consumption)
#
#   memo embed      TEXT [--compare-to TEXT] [--json]
#                   (the configured embedder's model and vector size for a text; how
#                    similar two texts are; --json adds the vector)
#
#   memo tune-weights [--scope SCOPE] [--samples N] [--metric r_at_1|r_at_3|r_at_5|r_at_10|mrr]
#                   [--json]
#                   (which MEMO_HYBRID_WEIGHTS blend finds this scope's memories best:
#                    each sampled memory is searched for by its own title at every
#                    blend; prints the memo config set command that applies the best)
#
#   memo kg         assert --subject S --predicate P --object O [--valid-from T]
#                          [--source-memory ID] [--supersede]
#                   | query [--subject S] [--predicate P] [--object O] [--at T]
#                          [--include-invalidated] [--limit N]
#                   | invalidate --subject S --predicate P [--object O] [--at T]
#                   | timeline --subject S --predicate P
#                   [--scope SCOPE]   (default: $MEMO_SCOPE)
#                   (knowledge graph: facts that hold over a time window — the history
#                    of a value that changes; --supersede ends the current value first)
#
#   memo brief      [--scope SCOPE]
#                   (tiny session-start digest: memory count + codebase-map size +
#                    tool hints; fail-soft, for auto-injection via a SessionStart hook)
#
#   memo consolidate [--scope SCOPE] [--dry-run] [--similarity-threshold F]
#                    [--decay-threshold F] [--max-rows N]
#                    (cluster related memories into observations)
#
#   memo digest     [--scope SCOPE] [--dry-run] [--threshold F]
#                   (hippocampus digest: promote tiers, delete stale ephemeral rows)
#
#   memo sense      --scope SCOPE [--generative] [--min-similarity F]
#                   (stdin: JSON array of {role,text} turns → record reinforcements)
#
#   memo learn      <scope> [--dry-run] [--min-samples N] [--margin F]
#                   | <scope> --status | <scope> --rollback
#                   (per-scope promotion harness: harvest → train → gated-promote reranker;
#                    --status: its versions and last runs; --rollback: back to the previous
#                    version — every run and rollback is recorded)
#
#   memo reembed    --scope SCOPE | --all [--batch N] [--dry-run]
#                   (re-embed every memory in a scope — or every scope — with the
#                    current embedder; needed after switching embedders: old vectors
#                    aren't comparable, and a new vector size needs --all)
#
#   memo backup     [PATH] [--force] [--db NAME|PATH]
#                   (a consistent copy of the database, safe while luamemo is in
#                    use; default ~/.local/share/luamemo/backups/<name>-<time>.db)
#
#   memo export     [--scope SCOPE]... [--no-vectors] [--out FILE] [--db NAME|PATH]
#   memo import     FILE|- [--dedup append|skip|update] [--scope SCOPE] [--dry-run]
#                   [--db NAME|PATH]
#                   (memories + facts as JSON Lines, between databases or embedders:
#                    vectors are reused when the embedder is the same, else re-embedded;
#                    importing the same export twice adds nothing.
#                    --db: another database than the project's)
#
#   memo promote    --from FROM_SCOPE --to TO_SCOPE [--delete-source] [--dry-run]
#                   [--limit N]
#
#   memo summarize  [--scope S] [--dry-run] [--weight-threshold F]
#                   [--retention-days N]
#
#   memo org        pair | status | pull [--full] | push | sync
#                   | proposals [list|candidates [--explain]|withdraw ID|private ID|public ID]
#                   | adopt [--dry-run] [--no-switch] | leave
#                   (dev: read-only org replica, feedback push + filtered knowledge
#                   proposals — needs MEMO_ORG_URL, MEMO_ORG_FINGERPRINT; also refreshed
#                   on session start / org search)
#   memo org        status | devs [pending|list|approve CODE|remove REF]
#                   | review [list|show ID|approve ID [--supersedes ORGID]|approve --top N
#                   |reject ID [--reason T]|remove ORGID]
#                   | directives <path> [--source N] [--project P] [--dry-run] [--no-prune]
#                   | aggregate [--dry-run] [--min-samples N]
#                   (org central: device pairing; devs' knowledge proposals; Markdown
#                   standards → protected core tier; digest + directives-gated
#                   promotion — MEMO_ROLE=org)
#
#   memo serve      [--host 127.0.0.1] [--port 8765] [--prefix /federation]
#                   (org central: federation API on the local network / VPN only;
#                   encrypted, key-authenticated — needs MEMO_ROLE=org, MEMO_ORG_NAME)
#
#   memo index      ingest [--root .] [--scope codeindex:proj] [--extensions csv|*]
#                          [--no-symbols] [--embed-file-rows] [--exclude a,b] [--no-gitignore]
#                          [--dry-run]   (--exclude adds to .git,vendor/,node_modules/;
#                          gitignored + credential files are skipped)
#                   update [--root .] [--scope codeindex:proj]  (same scan flags as ingest)
#                   search  <query>  [--scope codeindex:proj] [--kind symbol] [--limit N]
#                   explore <query>  [--scope codeindex:proj] [--limit N]
#                   status           [--scope codeindex:proj]
#                   invalidate <file|scope>
#                   diff   --commit SHA | --file FILE | --stdin [--scope codeindex:proj]
#                   (index a repo into codeindex:<project> — files/symbols/deps/diffs;
#                    Lua/Python/JS-TS parsers + universal-ctags for other languages)
#
#   memo calibrate  [--scope SCOPE] [--root DIR] [--db NAME|PATH] [--no-git]
#                   [--no-comments] [--probe-only] [--multilingual] [--long]
#                   [--allow-hash] [--write PATH] [--no-mcp]
#                   [--no-plugin] [--dry-run] [--keep-embedder] [--no-gguf]
#                   [-h|--help]
#                   (probe host + recommend embedder + the project's database +
#                    ingest codebase)
#                   --db: use this database (default: the project's own)
#                   --keep-embedder: skip probe-and-persist, preserve existing
#                   embedder config in .luamemorc
#                   --no-gguf: never pick / suggest the in-process GGUF embedder
#                   (gguf_ffi is only picked once a live test embedding succeeds)
#                   --no-plugin: skip VS Code agent plugin install
#                   -h, --help: show calibrate flag reference and exit
#
#   memo config     [list [--json | --markdown] | get KEY | set KEY VALUE [--user]
#                   | unset KEY [--user] | check | trust]
#                   (the settings: values and where each comes from; set / unset write the
#                    project's .luamemorc — or ~/.luamemorc with --user — after checking
#                    the value; a credential in a header is written {secret:NAME};
#                    trust: use a .luamemorc committed to git, after reviewing it;
#                    --markdown: the reference of every setting, as in SETTINGS.md)
#
#   memo mcp        [--project PATH] [--print-config]
#                   (the MCP stdio server — what an MCP client starts; the settings are
#                    the project's, found as for every command, so the client's config
#                    needs no MEMO_* environment; --print-config: that client entry)
#
#   memo gguf       [status | install]
#                   (the in-process GGUF embedder's runtime: what is in use and whether it
#                    loads; install downloads this release's prebuilt one for this machine,
#                    checked against the checksum the install ships)
#
#   memo ping       [--db] [--table] [--embedder]   Health check: SQLite + libsodium
#                   (versions, which copy), the database file, memories, embedder
#                   (exit 0/1)
#
#   memo setup      [--root DIR] [--force]
#                   Create SETUP_CHECK in the project root with first-run
#                   verification instructions for an AI agent. The file is
#                   deleted automatically when `memo calibrate` succeeds.
#
#   memo doctor     [--json]
#                   (corpus health: truncation counts, p95 row size)
#
#   memo secret-store   NAME [--desc DESCRIPTION] [--file PATH]
#   memo secret-list
#   memo secret-delete  NAME
#   memo secret-execute NAME URL [--method M] [--header K:V]...
#                               [--body TEXT] [--form FIELD=VALUE]...
#                               [--form-file FIELD:PATH] [--timeout-ms N]
#
#   memo help | --help | -h

set -euo pipefail

# The luamemo modules next to this script (a checkout, or a plugin's clone of the
# repository) come first on the Lua path — as mcp/server.lua does it — so memo runs
# the code it ships with from any directory, never another installed copy. A
# LuaRocks install keeps memo in <tree>/bin and the modules in <tree>/share/lua/5.1
# (C modules, e.g. luasocket, in <tree>/lib/lua/5.1): that tree comes first — a
# `luarocks --local` (~/.luarocks) or any other tree works without `luarocks path`.
_MEMO_SELF=$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")
_MEMO_ROOT=$(cd "$(dirname "$_MEMO_SELF")/.." 2>/dev/null && pwd -P || true)
if [[ -n "$_MEMO_ROOT" && -f "$_MEMO_ROOT/luamemo/init.lua" ]]; then
    export LUA_PATH="$_MEMO_ROOT/?.lua;$_MEMO_ROOT/?/init.lua;${LUA_PATH:-;}"
elif [[ -n "$_MEMO_ROOT" && -f "$_MEMO_ROOT/share/lua/5.1/luamemo/init.lua" ]]; then
    export LUA_PATH="$_MEMO_ROOT/share/lua/5.1/?.lua;$_MEMO_ROOT/share/lua/5.1/?/init.lua;${LUA_PATH:-;}"
    export LUA_CPATH="$_MEMO_ROOT/lib/lua/5.1/?.so;${LUA_CPATH:-;}"
fi
# Every Lua snippet memo runs starts with this: the module paths keep absolute entries
# only. LuaJIT's defaults begin with ./?.lua and ./?.so — the working directory — so in
# a project holding a luamemo/init.lua (or a cjson.lua, a socket/…), that file would run
# in luamemo's place, e.g. from the session-start hook when the project is opened.
_LUA_PATH_GUARD='for _, k in ipairs({ "path", "cpath" }) do local kept = {}
for e in package[k]:gmatch("[^;]+") do if e:sub(1, 1) == "/" then kept[#kept + 1] = e end end
package[k] = table.concat(kept, ";") end'

# ---------------------------------------------------------------------------
# Settings files — ~/.memorc, ~/.luamemorc, the project's .luamemorc — are DATA:
# MEMO_KEY=value lines, read without running anything ('single-quoted' as is, '\''
# for a quote; "double-quoted" or bare with $NAME / ${NAME} / a leading ~/ expanded;
# a bare value ends at " #"). luamemo.settings.read_file reads them the same way.
# A project's .luamemorc committed to git came with the repository — content you
# didn't write, which could point the embedder or the database elsewhere — so it is
# used only once you trusted it as it is (memo config trust; a changed file needs
# trusting again). One memo wrote (gitignored) is yours.
# ---------------------------------------------------------------------------
_RC_LINE_RE='^[[:space:]]*(export[[:space:]]+)?(MEMO_[A-Za-z0-9_]+)=(.*)$'
_RC_VAR_RE='^([^$]*)\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?(.*)$'
_rc_expand() {
    local rest="$1" out="" name
    [[ "$rest" == "~/"* ]] && rest="$HOME/${rest#\~/}"
    while [[ "$rest" =~ $_RC_VAR_RE ]]; do
        out+="${BASH_REMATCH[1]}"; name="${BASH_REMATCH[2]}"; rest="${BASH_REMATCH[3]}"
        out+="${!name:-}"
    done
    printf '%s' "$out$rest"
}
_rc_value() {
    local v="$1" sq="'"   # (the quote from a variable: bash 3.2, macOS's, kept the \ of \' in it)
    if [[ "$v" == \'* ]]; then
        v="${v#\'}"; v="${v%"${v##*[![:space:]]}"}"; v="${v%\'}"
        printf '%s' "${v//\'\\\'\'/$sq}"
    elif [[ "$v" == \"* ]]; then
        v="${v#\"}"; v="${v%"${v##*[![:space:]]}"}"; v="${v%\"}"
        v=$(_rc_expand "$v")
        v="${v//\\\"/\"}"; v="${v//\\\$/\$}"; v="${v//\\\`/\`}"; v="${v//\\\\/\\}"
        printf '%s' "$v"
    else
        v="${v%%[[:space:]]#*}"; v="${v%"${v##*[![:space:]]}"}"
        _rc_expand "$v"
    fi
}
# Settings that name code memo runs or loads (the interpreter, the native libraries, the
# GGUF shim): never taken from a project's .luamemorc, which a downloaded folder could
# bring — only from the environment and ~/.luamemorc (luamemo.settings.USER_ONLY).
_RC_USER_ONLY=" MEMO_LUA MEMO_LIB_SQLITE3 MEMO_LIB_SODIUM MEMO_GGUF_SHIM MEMO_GEMMA_SHIM "
# _load_rc FILE [project] — export the MEMO_ settings FILE holds (a project's: but the
# _RC_USER_ONLY ones).
_load_rc() {
    local line key raw
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ $_RC_LINE_RE ]] || continue
        key="${BASH_REMATCH[2]}"; raw="${BASH_REMATCH[3]}"
        if [[ "${2:-}" == project && "$_RC_USER_ONLY" == *" $key "* ]]; then
            echo "memo: ignoring $key in $1 — a project's settings never name code to run; set it in" \
                "~/.luamemorc or the environment" >&2
            continue
        fi
        export "$key=$(_rc_value "$raw")"
    done < "$1"
}
_trust_file() {
    printf '%s/trusted_rc' "${MEMO_FEDERATION_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/luamemo}"
}
_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum < "$1" | cut -d' ' -f1
    else shasum -a 256 < "$1" | cut -d' ' -f1; fi
}
_rc_abs() { printf '%s/%s' "$(cd "$(dirname -- "$1")" && pwd -P)" "$(basename -- "$1")"; }
_rc_committed() {
    git -C "$(dirname -- "$1")" ls-files --error-unmatch -- "$(basename -- "$1")" >/dev/null 2>&1
}
# _rc_usable FILE → 0 when memo may use a project's FILE: memo wrote it or you trusted it,
# as it is now — its checksum is in the trust list (luamemo.settings.trusted).
_rc_usable() {
    grep -qxF "$(_sha256 "$1") $(_rc_abs "$1")" "$(_trust_file)" 2>/dev/null
}
_rc_untrusted_why() {
    if _rc_committed "$1"; then echo "it is committed to the repository (not written on this machine)"
    else echo "memo didn't write it as it is now (it may have come with the project, or been edited)"; fi
}
_rc_untrusted_note() {
    echo "memo: ignoring $1 — $(_rc_untrusted_why "$1") and you haven't trusted it. Review it; if it's" \
        "fine: memo config trust" >&2
}

# Load the user's settings — ~/.luamemorc, for every project; exported, so the Lua
# processes memo starts inherit them. (~/.memorc, the older name, is no longer read:
# memo calibrate moves its settings into ~/.luamemorc.)
_MEMO_CONFIG_SOURCE=""
if [[ -f "$HOME/.luamemorc" ]]; then
    _memo_env_db="${MEMO_DB:-}"
    _load_rc "$HOME/.luamemorc"
    # "global" only when the user file itself named the database (not the environment).
    if [[ -n "${MEMO_DB:-}" && "${MEMO_DB:-}" != "$_memo_env_db" ]]; then
        _MEMO_CONFIG_SOURCE="global"; _MEMO_USER_DB_FILE="~/.luamemorc"
    fi
fi
if [[ -f "$HOME/.memorc" && "${1:-}" != "calibrate" ]]; then
    echo "memo: ~/.memorc is no longer read — run memo calibrate (it moves its settings into ~/.luamemorc)" >&2
fi
# The project — whose .luamemorc overrides the user's, so each project on this machine
# keeps its own database: for `memo calibrate --root DIR` / `memo mcp --project DIR`,
# DIR; else MEMO_PROJECT when set (the test runner uses it to keep a checkout's own
# .luamemorc out of the tests); else the nearest directory from here up that holds a
# .luamemorc (a subfolder of a project is that project — not the home directory's own
# file, which is the user's); else the current directory.
# luamemo.settings.project_dir finds it the same way.
_find_project() {
    local d="$1"
    while :; do
        if [[ -f "$d/.luamemorc" ]] && ! [[ -f "$HOME/.luamemorc" && "$d/.luamemorc" -ef "$HOME/.luamemorc" ]]; then
            printf '%s' "$d"; return 0
        fi
        [[ "$d" == "/" || "$d" == "$HOME" ]] && return 1
        d=$(dirname -- "$d")
    done
}
_memo_root_arg="" _memo_root_flag="" _memo_project_from="the working directory"
case "${1:-}" in
    calibrate) _memo_root_flag="--root" ;;
    mcp)       _memo_root_flag="--project" ;;
esac
if [[ -n "$_memo_root_flag" ]]; then
    _memo_prev=""
    for _memo_a in "$@"; do
        [[ "$_memo_prev" == "$_memo_root_flag" ]] && _memo_root_arg="$_memo_a"
        _memo_prev="$_memo_a"
    done
fi
if [[ -n "$_memo_root_arg" ]]; then
    _memo_project_from="$_memo_root_flag"
    _MEMO_PROJECT_DIR=$(cd "$_memo_root_arg" 2>/dev/null && pwd) || _MEMO_PROJECT_DIR="$_memo_root_arg"
elif [[ -n "${MEMO_PROJECT:-}" ]]; then
    _memo_project_from="MEMO_PROJECT"
    _MEMO_PROJECT_DIR="$MEMO_PROJECT"
else
    _MEMO_PROJECT_DIR=$(_find_project "$PWD") || _MEMO_PROJECT_DIR="$PWD"
fi
if [[ ! -d "$_MEMO_PROJECT_DIR" ]]; then
    echo "memo: $_memo_project_from is not a directory: $_MEMO_PROJECT_DIR" >&2
    exit 2
fi
# The Lua side reads the same project (luamemo.settings.files, memo org link / adopt / leave).
export MEMO__PROJECT_DIR="$_MEMO_PROJECT_DIR"
_MEMO_RC_UNTRUSTED=""
# Re-read the project's .luamemorc (after memo changed it) — when memo may use it.
_load_project_rc() {
    local f="$_MEMO_PROJECT_DIR/.luamemorc"
    [[ -f "$f" ]] || return 0
    [[ -f "$HOME/.luamemorc" && "$f" -ef "$HOME/.luamemorc" ]] && return 0   # read above
    if _rc_usable "$f"; then
        _load_rc "$f" project
    else
        _MEMO_RC_UNTRUSTED=1
        return 1
    fi
}
if [[ -f "$_MEMO_PROJECT_DIR/.luamemorc" ]]; then
    if _load_project_rc; then
        grep -q '^MEMO_DB=' "$_MEMO_PROJECT_DIR/.luamemorc" 2>/dev/null && _MEMO_CONFIG_SOURCE="local"
    else
        _rc_untrusted_note "$_MEMO_PROJECT_DIR/.luamemorc"
    fi
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

require_jq() {
    if ! command -v jq >/dev/null; then
        echo "memo: 'jq' is required but not installed" >&2
        exit 1
    fi
}

find_lua() {
    # luamemo runs on LuaJIT only: its FFI reaches SQLite and libsodium (and the
    # in-process GGUF embedder). MEMO_LUA names another LuaJIT binary (name or path).
    local cand="${MEMO_LUA:-luajit}"
    if command -v "$cand" >/dev/null; then echo "$cand"; return 0; fi
    return 1
}

# For callers that can't go on without Lua: lua=$(find_lua) || _no_lua
_no_lua() {
    if [[ -n "${MEMO_LUA:-}" ]]; then
        echo "memo: MEMO_LUA=$MEMO_LUA not found — it must name a LuaJIT interpreter" >&2
    else
        echo "memo: LuaJIT not found — install it (Debian / Ubuntu / WSL: sudo apt install luajit;" \
            "macOS: brew install luajit) or set MEMO_LUA to its path" >&2
    fi
    exit 1
}

# Run a single luamemo.cli.api command.
# $1 = command name (e.g. "write", "search")
# stdin = JSON input object
# stdout = JSON result
api_call() {
    local cmd="$1"
    local lua; lua=$(find_lua) || _no_lua
    "$lua" -e "$_LUA_PATH_GUARD
require('luamemo.cli.api').dispatch('${cmd}')"
}

# Run luamemo.cli.<module>.run(argv) WITHOUT putting the arguments in Lua code:
# each one travels hex-encoded in MEMO__ARGV and is decoded on the Lua side, so
# any value — a search query, a crafted directory name — stays data.
#   _lua_run <lua> <module> [args…]      (cmd_local_lua execs the same program)
_lua_argv() {
    local out="" a
    for a in "$@"; do
        out+="x$(printf '%s' "$a" | od -An -v -tx1 | tr -d ' \n') "
    done
    printf '%s' "$out"
}
_LUA_RUN="$_LUA_PATH_GUARD"'
local argv = {}
for h in (os.getenv("MEMO__ARGV") or ""):gmatch("x(%x*)") do
    argv[#argv + 1] = (h:gsub("%x%x", function(b) return string.char(tonumber(b, 16)) end))
end
require("luamemo.cli." .. os.getenv("MEMO__MODULE")).run(argv)'
_lua_run() {
    local lua="$1" module="$2"; shift 2
    MEMO__ARGV="$(_lua_argv "$@")" MEMO__MODULE="$module" "$lua" -e "$_LUA_RUN"
}

# Build a JSON object from --key value pairs passed as arguments, in one jq call.
# --tags is split on commas into an array. --body - reads the body from stdin (the
# session hooks: a chat's text never goes on a command line, where ps shows it).
build_json() {
    require_jq
    local args=()
    while [[ $# -gt 0 ]]; do
        [[ $# -ge 2 ]] || { echo "memo: $1 needs a value" >&2; return 2; }
        local key="${1#--}"; key="${key//-/_}"   # --decay-rate → decay_rate
        if [[ "$key" == "body" && "$2" == "-" ]]; then
            args+=(--rawfile body /dev/stdin)
        else
            args+=(--arg "$key" "$2")
        fi
        shift 2
    done
    jq -nc ${args[@]+"${args[@]}"} \
        '$ARGS.named | if has("tags") then .tags |= (split(",") | map(gsub("^\\s+|\\s+$"; ""))) else . end'
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_write() {
    require_jq
    local body; body=$(build_json "$@") || exit 2
    printf '%s' "$body" | api_call write | jq .
}

cmd_search() {
    require_jq
    local q="$1"; shift
