# ---------------------------------------------------------------------------
# Settings files. _save_rc_key FILE KEY VALUE writes or replaces one KEY=VALUE line
# with luamemo's own writer (luamemo.cli._common.rc_set, as memo config set does): the
# value single-quoted (read back literally — _load_rc reads the file as data), a
# newline refused; a project's file only one memo wrote or you trusted, never through
# a symlink, 0600 and atomic, and trusted as written.
# _rc_get FILE KEY reads one value back as _load_rc reads it (_rc_value: any quoting;
# the last line for KEY wins); nothing when FILE or KEY is missing.
# ---------------------------------------------------------------------------
_rc_get() {
    local line raw=""
    [[ -f "$1" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ $_RC_LINE_RE && "${BASH_REMATCH[2]}" == "$2" ]]; then raw="${BASH_REMATCH[3]}"; fi
    done < "$1"
    if [[ -n "$raw" ]]; then _rc_value "$raw"; fi
}

_save_rc_key() {
    local lua; lua=$(find_lua) || _no_lua
    MEMO__RC_FILE="$1" MEMO__RC_KEY="$2" MEMO__RC_VALUE="$3" "$lua" -e "$_LUA_PATH_GUARD
local ok, err = require('luamemo.cli._common').rc_set(os.getenv('MEMO__RC_FILE'), os.getenv('MEMO__RC_KEY'),
    os.getenv('MEMO__RC_VALUE'))
if not ok then io.stderr:write('memo: ', tostring(err), '\n'); os.exit(1) end"
}

# ~/.memorc (the older name of the user's settings file) → ~/.luamemorc: each setting it
# has that ~/.luamemorc doesn't is moved over (a setting already there is kept), then
# ~/.memorc is removed and the user file read again (the project's still wins).
_migrate_memorc() {
    local old="$HOME/.memorc" new="$HOME/.luamemorc" line key raw moved=0 kept=0
    [[ -f "$old" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ $_RC_LINE_RE ]] || continue
        key="${BASH_REMATCH[2]}"; raw="${BASH_REMATCH[3]}"
        if [[ -f "$new" ]] && grep -q "^\(export \)\?${key}=" "$new"; then
            kept=$((kept + 1))
        else
            _save_rc_key "$new" "$key" "$(_rc_value "$raw")" && moved=$((moved + 1))
        fi
    done < "$old"
    rm -f "$old"
    echo "Moved ~/.memorc into ~/.luamemorc: $moved setting(s) moved, $kept already set there (kept);" \
        "~/.memorc removed."
    local before="${MEMO_DB:-}"
    [[ -f "$new" ]] && _load_rc "$new"
    if [[ -n "${MEMO_DB:-}" && "${MEMO_DB:-}" != "$before" ]]; then
        _MEMO_CONFIG_SOURCE="global"; _MEMO_USER_DB_FILE="~/.luamemorc"
    fi
    _load_project_rc || true
}

# Write key=value only when the key is not already present in the file.
# Used for probe-recommended embedder vars: on first run they are written from
# the system recommendation; on subsequent runs the user's values are preserved.
_save_rc_key_if_absent() {
    local file="$1" key="$2" value="$3"
    [[ -f "$file" ]] && grep -q "^${key}=" "$file" && return 0
    _save_rc_key "$file" "$key" "$value"
}

# Save MEMO_DB (the project's database: a name, or a path) to .luamemorc.
_save_db_rc() {
    _save_rc_key "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_DB" "$1"
    _gitignore_local "$_MEMO_PROJECT_DIR" ".luamemorc"
}

# .luamemorc holds this machine's settings (its database, its embedder and model
# paths): in a git work tree, append it to the .gitignore next to it unless it's
# ignored already. A file git already TRACKS can't be ignored — then say how to
# untrack it.
_gitignore_local() {
    local dir="$1" rel="$2"
    git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    if git -C "$dir" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
        echo "  Note: $rel is tracked by git, but it holds this machine's settings (database,"
        echo "        embedder) — untrack it (git rm --cached $rel) unless every machine shares them"
        echo "        (each machine then runs memo config trust once it has reviewed the file)."
        return 0
    fi
    git -C "$dir" check-ignore -q -- "$rel" 2>/dev/null && return 0
    local gi="$dir/.gitignore"
    [[ -s "$gi" && -n "$(tail -c1 "$gi")" ]] && printf '\n' >> "$gi"
    printf '%s\n' "$rel" >> "$gi"
    echo "  Added $rel to .gitignore (it holds this machine's settings)."
}

# The name of the project's own database: the directory's name (letters, digits,
# '.', '_', '-') and a checksum of its full path, so two projects that share a
# directory name never share a database. e.g. myapp-1c0d4e8f
_project_db_name() {
    local dir; dir=$(cd "$1" 2>/dev/null && pwd -P) || dir="$1"
    local base; base=$(printf '%s' "${dir##*/}" | tr -c 'A-Za-z0-9._-' '-' | tr -s '-' | sed 's/^[^A-Za-z0-9]*//' | cut -c1-40)
    [[ -n "$base" ]] || base="project"
    printf '%s-%08x' "$base" "$(printf '%s' "$dir" | cksum | cut -d' ' -f1)"
}

# ---------------------------------------------------------------------------
# Federation setup (called from cmd_calibrate phase 2.6). No secret is ever
# typed, printed or stored in the project: each side has an Ed25519 identity
# key in the per-user keyring (~/.config/luamemo), and only PUBLIC values —
# the central's address and key fingerprint, pairing codes — appear here.
# ---------------------------------------------------------------------------

# Canonical fingerprint for comparisons (case, dashes, spaces, O→0, I/L→1).
_norm_fp() { printf '%s' "$1" | tr 'a-z' 'A-Z' | tr -d ' -' | tr 'OIL' '011'; }

# The database this machine already uses for the org with this central key
# (per-user registry). Empty when none.
_org_db_for_fp() {
    local lua="$1" fp="$2"
    [[ -n "$fp" ]] || return 0
    MEMO__ORG_FP="$fp" "$lua" -e "$_LUA_PATH_GUARD
local e = require('luamemo.federation.registry').get(os.getenv('MEMO__ORG_FP'))
if e and e.db then io.write(e.db) end" 2>/dev/null || true
}

# Re-read .luamemorc after `memo org link|adopt` pointed it at the org database
# and its embedder (keys it removed must not linger in this shell).
_reload_db_rc() {
    unset MEMO_DB MEMO_EMBEDDER MEMO_EMBEDDER_URL MEMO_EMBEDDER_ADAPTER MEMO_EMBEDDER_MODEL \
          MEMO_GGUF_MODEL MEMO_EMBED_DIM MEMO_EMBED_MAX_CHARS
    _load_project_rc || true
    _gitignore_local "$_MEMO_PROJECT_DIR" ".luamemorc"   # it now names the org database
}

# Leaving the org (calibrate --role solo): last push, replica cleanup, keys removed.
_calibrate_org_leave() {
    local lua="$1"
    grep -q '^MEMO_ORG_URL=' "$_MEMO_PROJECT_DIR/.luamemorc" 2>/dev/null || return 0
    echo ""
    echo "Federation: leaving the org (this project goes back to solo)"
    _run_org "$lua" leave --project "$_MEMO_PROJECT_DIR" 2>&1 | sed 's/^/    /'
    unset MEMO_ORG_URL MEMO_ORG_FINGERPRINT
}

# _run_org <lua> <subcommand…> — `memo org …` without exec (cmd_local_lua execs).
_run_org() {
    local lua="$1"; shift
    _lua_run "$lua" org "$@"
}

# Dev: pin the central (URL + fingerprint), create this device's key, ask to
# pair, and sync once approved. Only public values are ever shown or stored.
_calibrate_org_dev() {
    local lua="$1" url="$2" fingerprint="$3"
    echo ""
    echo "Federation: joining org central $(_redact_url "$url") as a dev"
    [[ -z "$fingerprint" ]] && fingerprint="${MEMO_ORG_FINGERPRINT:-}"
    if [[ -z "$fingerprint" ]]; then
        if [[ ! -t 0 ]]; then
            echo "  No central fingerprint given — ask your org admin for it (\`memo org status\` on"
            echo "  the central shows it) and re-run with --org-fingerprint XXXX-XXXX-XXXX-XXXX-XXXX."
            return 1
        fi
        # Interactive: show what the central presents; the PERSON compares it
        # with the fingerprint the org admin gave them. Never pinned blindly.
        local probe fp org
        if ! probe=$( export MEMO_ORG_URL="$url"; _run_org "$lua" probe 2>&1 ); then
            printf '%s\n' "$probe" | sed 's/^/    /'
            echo "  Cannot read the central's identity — check the address (local network / VPN only)."
            return 1
        fi
        fp=$(printf '%s\n' "$probe" | awk '/^fingerprint:/{print $2}')
        org=$(printf '%s\n' "$probe" | sed -n 's/^org: *//p')
        echo "  The central at $(_redact_url "$url") presents:"
        echo "    fingerprint  $fp"
        echo "    org          $org"
        echo "  Compare the fingerprint with the one your org admin gave you, character by character."
        if ! _confirm_yn "Does it match exactly?"; then
            echo "  Not pinned — nothing configured. If it doesn't match, tell your org admin."
            return 1
        fi
        fingerprint="$fp"
    fi
    # A different central key = a different org: leave the old one first (last
    # push; its replica goes when no other project here still uses it). The same
    # key at a new address is just an address update.
    local old_fp
    old_fp=$(_rc_get "$_MEMO_PROJECT_DIR/.luamemorc" MEMO_ORG_FINGERPRINT)
    if [[ -n "$old_fp" && "$(_norm_fp "$old_fp")" != "$(_norm_fp "$fingerprint")" ]]; then
        echo "  This project was federated with another org (central ${old_fp}) — leaving it first:"
        _run_org "$lua" leave --project "$_MEMO_PROJECT_DIR" 2>&1 | sed 's/^/    /'
    fi
    export MEMO_ORG_URL="$url" MEMO_ORG_FINGERPRINT="$fingerprint"
    _save_rc_key "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_ORG_URL" "$url"
    _save_rc_key "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_ORG_FINGERPRINT" "$fingerprint"
    echo "  Saved MEMO_ORG_URL + MEMO_ORG_FINGERPRINT to .luamemorc (public values)"
    # One local database per org: the first project's database becomes the org
    # database on this machine, later projects join it (or copy into it).
    local pscope="${scope:-${MEMO_SCOPE:-repo:$(basename "$_MEMO_PROJECT_DIR")}}" link_out link_action
    link_out=$(_run_org "$lua" link --project "$_MEMO_PROJECT_DIR" --scope "$pscope" 2>&1) || true
    printf '%s\n' "$link_out" | grep -v '^LINK=' | sed 's/^/    /'
    link_action=$(printf '%s\n' "$link_out" | sed -n 's/^LINK=//p')
    case "$link_action" in
        conflict)
            unset MEMO_ORG_URL MEMO_ORG_FINGERPRINT   # link removed them from .luamemorc
            echo "  Not joined (one org per database)."
            return 1 ;;
        switched|same)
            _reload_db_rc ;;
        adopt*)
            if [[ -t 0 ]] && _confirm_yn "Copy this project's ${link_action#adopt } memories into the org database and switch to it (the current database is left as is)?"; then
                _run_org "$lua" adopt --project "$_MEMO_PROJECT_DIR" --scope "$pscope" 2>&1 | sed 's/^/    /'
                _reload_db_rc
            else
                echo "  Kept this project's own database (still federated). To move it later: memo org adopt"
            fi ;;
    esac
    echo "  Pairing this device:"
    local out rc
    out=$(_run_org "$lua" pair 2>&1); rc=$?
    printf '%s\n' "$out" | sed 's/^/    /'
    if [[ $rc -ne 0 ]]; then
        echo "  Pairing failed — the config is kept; retry with: memo org pair"
        return 1
    fi
    local approved=false
    if printf '%s\n' "$out" | grep -q '^status: *approved'; then
        approved=true
    elif [[ -t 0 ]] && _confirm_yn "Wait here while your org admin approves the code (up to 3 minutes)?"; then
        _run_org "$lua" pair --wait 180 2>&1 | sed 's/^/    /'
        [[ "${PIPESTATUS[0]}" -eq 0 ]] && approved=true
    fi
    if [[ "$approved" == true ]]; then
        echo "  First sync (read-only org replica + promoted weights):"
        _run_org "$lua" sync 2>&1 | sed 's/^/    /'
        [[ "${PIPESTATUS[0]}" -eq 0 ]] \
            || echo "  First sync failed — it retries on the next session start, org search, or: memo org sync"
    else
        echo "  Once your org admin approves the code: memo org sync (sessions also sync on their own)"
    fi
}

# Org central: persist the role, create the central identity key, print the
# public fingerprint devs pin and the operating recipe.
_calibrate_org_central() {
    local lua="$1" name="$2"
    echo ""
    echo "Federation: configuring this instance as the org central for org:${name}"
    _save_rc_key "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_ROLE" "org"
    _save_rc_key "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_ORG_NAME" "$name"
    export MEMO_ROLE=org MEMO_ORG_NAME="$name"
    echo "  Saved MEMO_ROLE + MEMO_ORG_NAME to .luamemorc"
    local fp
    fp=$("$lua" -e "$_LUA_PATH_GUARD
        local k = require('luamemo.federation.keys')
        local pk = assert(k.ensure_identity('central'))
        io.write(k.fingerprint(pk))" 2>&1) || {
        echo "  ERROR: could not create the central identity key: $fp" >&2
        return 1
    }
    echo "  Central identity key ready (per-user keyring, encrypted) — fingerprint: $fp"
    echo ""
    _run_org "$lua" status 2>&1 | sed 's/^/    /'
    [[ "${PIPESTATUS[0]}" -eq 0 ]] || return 1
    # Suggest an address devs can reach: the Tailscale IPv4 when present, else a
    # typical LAN address (192.168.*, then 10.* — Docker bridges usually sit in
    # 172.17–19.*), else whatever comes first.
    # (|| true: under set -e a failed lookup ended `memo calibrate` here — hostname -I is
    # Linux-only, macOS asks ipconfig; tailscale logged out fails too)
    local host=""
    if command -v tailscale >/dev/null 2>&1; then host=$(tailscale ip -4 2>/dev/null | head -1) || true; fi
    [[ -n "$host" ]] || host=$( { hostname -I 2>/dev/null \
            || { ipconfig getifaddr en0 2>/dev/null; ipconfig getifaddr en1 2>/dev/null; }; } \
        | tr ' ' '\n' | awk '
        /^192\.168\./ { if (!a) a = $0 } /^10\./ { if (!b) b = $0 } NF { if (!c) c = $0 }
        END { print (a ? a : (b ? b : c)) }') || true
    [[ -n "$host" ]] || host="<this machine's LAN / Tailscale IP>"
    cat <<EOF

  Next:
    memo serve --host ${host} --port 8765
                                      # local network only; encrypted, key-authenticated
    memo org directives ./standards   # Markdown standards → protected core tier (re-run on change)
    memo org devs pending             # pairing requests; approve with the code the dev reads you:
    memo org devs approve <CODE>
    memo org devs clear-pending       # junk in the queue: drop every pending request
    memo org review                   # devs' knowledge proposals — approve / reject (your decision)
    memo org aggregate                # digest + directives-gated promotion (schedule it, e.g. hourly)
  Devs join with (all public values — safe to share in chat or docs):
    memo calibrate --org-url http://${host}:8765 --org-fingerprint ${fp}
EOF
}

# ---------------------------------------------------------------------------
# memo setup — create SETUP_CHECK for first-run agent-guided verification.
# ---------------------------------------------------------------------------
cmd_setup() {
    local root="$_MEMO_PROJECT_DIR" force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root)  root="$2"; shift 2 ;;
            --force) force=true; shift ;;
            *) echo "memo setup: unknown arg: $1" >&2; exit 1 ;;
        esac
    done

    local target; target="${root}/SETUP_CHECK"

    [[ -d "$root" ]] || { echo "memo setup: directory not found: $root" >&2; exit 1; }
    if [[ -f "$target" ]] && [[ "$force" != true ]]; then
        echo "memo setup: $target already exists (use --force to overwrite)." >&2
        echo "  If you are an AI agent, run \`memo calibrate\` to complete setup" >&2
        echo "  and remove the file automatically." >&2
        exit 1
    fi

    cat > "$target" << 'SETUP_EOF'
luamemo — First-Run Setup Verification
=======================================
This file was created by `memo setup`. It will be deleted automatically
when `memo calibrate` completes successfully. Do not commit this file.

If you are an AI agent, complete these steps in order:

  1. Run the full setup (host probe, this project's database, codebase
     ingest, IDE/MCP config detection):

         memo calibrate --scope <your-project-scope>

     Replace <your-project-scope> with a short identifier for this project
     (e.g. "myapp" or "repo:myproject"). All ingested memories are tagged
     with this scope so they do not pollute unrelated projects.
     The database is a local file calibrate creates for this project (in
     ~/.local/share/luamemo) — there is no database server to set up.

  2. Verify:

         memo ping

     Expected: [PASS] for SQLite, libsodium, Database and Memories. An
     Embedder failure means the embedder isn't reachable — writes need it.

  3. Confirm success:
     `memo calibrate` will print "First-run complete: SETUP_CHECK removed."
     and delete this file. If the file is still present, calibrate did not
     finish cleanly — check the output for errors and re-run.

If calibrate fails at any step, fix the reported error and run it again.
The file will not be deleted until calibrate exits successfully.
SETUP_EOF

    echo "Created: $target"
    echo "  Run \`memo calibrate\` to complete setup and remove the file."
    if [[ -e "${root}/.git" ]]; then
        local gitignore="${root}/.gitignore"
        if [[ -f "$gitignore" ]] && grep -qF 'SETUP_CHECK' "$gitignore" 2>/dev/null; then
            : # already ignored
        else
            echo "  Tip: add SETUP_CHECK to your .gitignore so it is not committed."
        fi
    fi
}

# memo calibrate — three-phase host probe, corpus health check, codebase ingest.
# ---------------------------------------------------------------------------
cmd_calibrate() {
    local root="$_MEMO_PROJECT_DIR" scope="" dry_run=false no_git=false no_comments=false probe_only=false
    local no_mcp=false no_plugin=false keep_embedder=false db_flag=""
    local lua_extra_args=()
    local role="" org_url="" org_fingerprint="" org_name=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help)
                cat <<'EOF'
Usage: memo calibrate [OPTIONS]

Probe the environment, set up this project's database, configure luamemo, and
write .vscode/mcp.json.

Options:
  --scope SCOPE         Memory scope for calibration (default: repo:<basename>)
  --root DIR            The project's directory (default: the nearest folder from
                        here up with a .luamemorc, else the current one) — DIR
                        becomes a project of its own
  --db NAME|PATH        The database to use (default: this project's own, a file
                        in ~/.local/share/luamemo named after the project)
  --no-mcp              Skip writing .vscode/mcp.json
  --no-plugin           Skip installing the VS Code agent plugin
  --keep-embedder       Do not overwrite existing embedder config in .luamemorc
  --probe-only          Run host probe only; skip the database and codebase ingest
  --no-git              Skip git-history scan
  --no-comments         Skip code comment extraction
  --dry-run             Show what would be written without writing
  --multilingual        Include non-Lua source files in scan
  --long                Allow longer memory bodies
  --allow-hash          Allow hash embedder (normally skipped in calibrate)
  --no-gguf             Never pick / suggest the in-process GGUF embedder
  --write PATH          Write scan output to a file instead of DB
  -h, --help            Show this help and exit

Federation (optional — see README "Federation"):
  --org-url URL         Join an org central as a dev (local network / VPN only):
                        read-only org replica + feedback push. Creates this
                        device's key and asks the central to pair it — the org
                        admin approves the code it shows. Nothing secret is typed.
  --org-fingerprint FP  The central's key fingerprint (public — from the org admin)
                        All of one org's projects on this machine share one
                        database; a project with its own memories is offered a
                        copy into it (memo org adopt). A different central =
                        a different org: the old one is left first.
  --role solo           Leave the org this project was federated with (last push;
                        the replica goes when no other project here uses it)
  --role org            Configure THIS instance as the org central (with
  --org-name NAME       --org-name): persists the role, creates the central's
                        identity key, prints its fingerprint + the serve /
                        pairing / directives / aggregate recipe; skips the
                        per-dev phases (ingest, MCP, plugin)
EOF
                exit 0
                ;;
            --root)        root="$2";        shift 2 ;;
            --scope)       scope="$2";       shift 2 ;;
            --dry-run)     dry_run=true;     shift   ;;
            --no-git)      no_git=true;      shift   ;;
            --no-comments) no_comments=true; shift   ;;
            --probe-only)  probe_only=true;  shift   ;;
            --db)          db_flag="$2";     shift 2 ;;
            --no-mcp)      no_mcp=true;      shift   ;;
            --no-plugin)   no_plugin=true;   shift   ;;
            --keep-embedder) keep_embedder=true; shift ;;
            --non-interactive|--multilingual|--long|--allow-hash|--no-gguf)
                lua_extra_args+=("$1"); shift ;;
            --write)
                lua_extra_args+=(--write "$2"); shift 2 ;;
            --role)        role="$2";        shift 2 ;;
            --org-url)     org_url="$2";     shift 2 ;;
            --org-fingerprint) org_fingerprint="$2"; shift 2 ;;
            --org-name)    org_name="$2";    shift 2 ;;
            *) echo "memo calibrate: unknown arg: $1" >&2; exit 1 ;;
        esac
    done

    # Federation flags are validated up front — before anything is written.
    case "$role" in
        ""|solo|dev) ;;
        org)
            if [[ -n "$org_url" ]]; then
                echo "memo calibrate: --role org is the central itself; --org-url is for devs" >&2; exit 1
            fi
            if ! [[ "$org_name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || (( ${#org_name} > 64 )); then
                echo "memo calibrate: --role org needs --org-name NAME (letters, digits, . _ -; at most 64)" >&2
                exit 1
            fi ;;
        *) echo "memo calibrate: --role must be solo, dev or org" >&2; exit 1 ;;
    esac
    if [[ "$role" == "dev" && -z "$org_url" ]]; then
        echo "memo calibrate: --role dev needs --org-url URL" >&2; exit 1
    fi
    if [[ -n "$org_url" ]] && ! [[ "$org_url" =~ ^https?://[^[:space:]]+$ ]]; then
        echo "memo calibrate: --org-url must be an http(s):// URL" >&2; exit 1
    fi
    if [[ -n "$org_fingerprint" && -z "$org_url" ]]; then
        echo "memo calibrate: --org-fingerprint needs --org-url" >&2; exit 1
    fi
    if [[ -n "$db_flag" && "$db_flag" != */* ]] && ! [[ "$db_flag" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo "memo calibrate: --db NAME is letters, digits, '.', '_' or '-' (or a path with a '/')" >&2; exit 1
    fi

    local lua; lua=$(find_lua) || _no_lua

    # A .luamemorc memo didn't write (it came with the repository or a download, or was
    # edited): calibrate would build on it.
    if [[ -n "$_MEMO_RC_UNTRUSTED" ]]; then
        echo "memo calibrate: this project's .luamemorc — $(_rc_untrusted_why "$_MEMO_PROJECT_DIR/.luamemorc")" >&2
        echo "  — and you haven't trusted it. Review it, then either trust it (memo config trust) or remove it" >&2
        echo "  (calibrate writes this machine's own)." >&2
        return 1
    fi

    # ~/.memorc is no longer read: its settings move into ~/.luamemorc first.
    [[ "$dry_run" != true && "$probe_only" != true ]] && _migrate_memorc
    [[ "$_MEMO_PROJECT_DIR" != "$PWD" ]] && echo "Project: $_MEMO_PROJECT_DIR"

    # The settings, checked once for the whole run (the Lua steps below stay quiet):
    # a value that doesn't parse, a MEMO_ name luamemo doesn't read.
    local _cfg_check
    _cfg_check=$(MEMO__PROJECT_DIR="$_MEMO_PROJECT_DIR" _lua_run "$lua" config check 2>&1) \
        || { echo "Settings:"; printf '%s\n' "$_cfg_check" | sed 's/^/  /'; }
    export MEMO__SETTINGS_CHECKED=1

    # ── Phase 0: the in-process GGUF runtime, prebuilt — when this release ships one
    # for this machine and the shim isn't there yet: offered, so the probe below can
    # find the GGUF embedder ready (no compiler needed). The model stays the user's step.
    if [[ "$probe_only" != true && "$dry_run" != true && "${keep_embedder:-false}" != true \
          && " ${lua_extra_args[*]+${lua_extra_args[*]}} " != *" --no-gguf "* ]]; then
        _calibrate_gguf_runtime "$lua"
    fi

    # ── Phase 1: host probe + embedder recommendation (no DB required) ──────
    # The probe writes its recommendation as MEMO_*='value' lines to a temp file;
    # the embedder settings are read back from it.
    local _probe_tmp; _probe_tmp=$(mktemp /tmp/luamemo_probe_XXXXXX)
    _lua_run "$lua" calibrate --root "$root" ${lua_extra_args[@]+"${lua_extra_args[@]}"} --write "$_probe_tmp"
    local _probe_embed_dim _probe_eloc _probe_eadp _probe_eurl _probe_emdl _probe_emxc
    _probe_embed_dim=$(_rc_get "$_probe_tmp" MEMO_EMBED_DIM)
    _probe_eloc=$(_rc_get "$_probe_tmp" MEMO_EMBEDDER)
    _probe_eadp=$(_rc_get "$_probe_tmp" MEMO_EMBEDDER_ADAPTER)
    _probe_eurl=$(_rc_get "$_probe_tmp" MEMO_EMBEDDER_URL)
    _probe_emdl=$(_rc_get "$_probe_tmp" MEMO_EMBEDDER_MODEL)
    [[ -n "$_probe_emdl" ]] || _probe_emdl=$(_rc_get "$_probe_tmp" MEMO_GGUF_MODEL)
    _probe_emxc=$(_rc_get "$_probe_tmp" MEMO_EMBED_MAX_CHARS)
    [[ -n "$_probe_embed_dim" ]] || _probe_embed_dim=384
    rm -f "$_probe_tmp"
    [[ "$probe_only" == true ]] && return 0

    # ── Phase 2: the project's database ─────────────────────────────────────
    # A SQLite file — no server to set up: it is created, with its schema, on
    # first open. Which one (first match wins):
    #   1. --db NAME|PATH
    #   2. the one the project's .luamemorc names (the project is configured)
    #   3. MEMO_DB exported in this shell — not one from ~/.memorc / ~/.luamemorc:
    #      that one is every project's, and a project never takes it over silently
    #   4. joining an org this machine already belongs to → that org's database
    #      (one database per org, shared by its projects)
    #   5. the project's own, named after it: <directory>-<checksum>
    local _rc_db=""
    [[ -f "$_MEMO_PROJECT_DIR/.luamemorc" ]] && _rc_db=$(_rc_get "$_MEMO_PROJECT_DIR/.luamemorc" MEMO_DB)
    echo ""
    if [[ -n "$db_flag" ]]; then
        export MEMO_DB="$db_flag"
        echo "Database: ${MEMO_DB} (--db)"
    elif [[ -n "$_rc_db" ]]; then
        export MEMO_DB="$_rc_db"
        echo "Database: ${MEMO_DB} (this project's, from .luamemorc)"
    else
        if [[ "${_MEMO_CONFIG_SOURCE:-}" == "global" ]]; then
            echo "Note: ${_MEMO_USER_DB_FILE:-~/.luamemorc} sets MEMO_DB=${MEMO_DB:-} for every project — this project gets its own"
            echo "      database; to use that one instead: memo calibrate --db ${MEMO_DB:-}"
            unset MEMO_DB
        fi
        if [[ -n "${MEMO_DB:-}" ]]; then
            echo "Database: ${MEMO_DB} (MEMO_DB)"
        else
            local _odb; _odb=$(_org_db_for_fp "$lua" "${org_fingerprint:-${MEMO_ORG_FINGERPRINT:-}}")
            if [[ -n "$_odb" ]]; then
                export MEMO_DB="$_odb"
                echo "Database: ${MEMO_DB} (this org's database on this machine, shared by its projects)"
            else
                MEMO_DB=$(_project_db_name "$_MEMO_PROJECT_DIR")
                export MEMO_DB
                echo "Database: ${MEMO_DB} (this project's own)"
            fi
        fi
    fi
    if [[ "$dry_run" != true && "$MEMO_DB" != "$_rc_db" ]]; then
        _save_db_rc "$MEMO_DB"
        echo "  Saved MEMO_DB to .luamemorc — memo and the MCP server use this database."
    fi
    # Open it (created when new) and check what luamemo runs on.
    local _ping_out _ping_rc=0
    _ping_out=$(_lua_run "$lua" ping --table 2>&1) || _ping_rc=$?
    printf '%s\n' "$_ping_out" | sed 's/^/  /'
    if [[ "$_ping_rc" -ne 0 ]]; then
        echo "  The database can't be used — fix what FAIL names above, then re-run: memo calibrate" >&2
        return 1
    fi

    # ── The embedder: the probe's recommendation, recorded in .luamemorc ────
    # Write-if-absent: a value the user set (or an earlier run recorded) is kept —
    # the probe only echoes back what it found in the environment anyway.
    # --keep-embedder leaves the embedder settings alone entirely.
    if [[ "$keep_embedder" != true && "$dry_run" != true ]]; then
        # Embedder-switch warning: two different embedders' vectors are NEVER
        # comparable, even at the same embed_dim — existing rows silently lose
        # vector-search relevance until re-embedded (FTS still works, which is
        # exactly why this is easy to miss). Two ways this happens even under
        # write-if-absent semantics below: (a) the embedder actually changed
        # from what .luamemorc already had, or (b) this is a FRESH .luamemorc
        # (no local prior value to compare) on a database that already has rows
        # for this scope — e.g. a project joining a database another one fills.
        local _old_eloc="" _old_emdl=""
        if [[ -f "$_MEMO_PROJECT_DIR/.luamemorc" ]]; then
            _old_eloc=$(_rc_get "$_MEMO_PROJECT_DIR/.luamemorc" MEMO_EMBEDDER)
            _old_emdl=$(_rc_get "$_MEMO_PROJECT_DIR/.luamemorc" MEMO_EMBEDDER_MODEL)
        fi
        local _embedder_changed=false
        if [[ -n "$_old_eloc" && -n "$_probe_eloc" && "$_old_eloc" != "$_probe_eloc" ]]; then
            _embedder_changed=true
        elif [[ -n "$_old_emdl" && -n "$_probe_emdl" && "$_old_emdl" != "$_probe_emdl" ]]; then
            _embedder_changed=true
        fi

        local _target_scope="${scope:-repo:$(basename "$(cd "$root" 2>/dev/null && pwd)")}"
        local _existing_rows=""
        _existing_rows=$(jq -n --arg s "$_target_scope" '{scope: $s}' | api_call db-info 2>/dev/null \
            | jq -r '.scope_memories // empty' 2>/dev/null) || _existing_rows=""
        if [[ "$_existing_rows" =~ ^[0-9]+$ ]] && [[ "$_existing_rows" -gt 0 ]]; then
            if [[ "$_embedder_changed" == true ]]; then
                echo ""
                echo "  WARNING: embedder is changing (${_old_eloc:-$_old_emdl} -> ${_probe_eloc:-$_probe_emdl})."
                echo "  ${_existing_rows} existing memories in scope '${_target_scope}' were embedded with"
                echo "  the PREVIOUS model — a different model's vectors are never comparable, even at the"
                echo "  same dimension, so vector search relevance will silently degrade on those rows"
                echo "  until they are re-embedded. Run:  memo reembed --all"
            elif [[ -z "$_old_eloc" ]]; then
                echo ""
                echo "  NOTE: scope '${_target_scope}' already has ${_existing_rows} memories, but no local"
                echo "  embedder config was found (e.g. a project joining a database another one fills)."
                echo "  If those rows were embedded with a DIFFERENT model than the one being configured"
                echo "  now, vector search relevance will be degraded until they are re-embedded. Run:"
                echo "    memo reembed --all"
            fi
        fi

        # Local embedder selector (hash / gguf_ffi / …). For gguf_ffi the user
        # also sets MEMO_GGUF_MODEL after downloading the model (see the guide
        # printed by `memo calibrate`).
        [[ -n "$_probe_eloc" ]] && _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_EMBEDDER" "$_probe_eloc"
        [[ -n "$_probe_eadp" ]] && _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_EMBEDDER_ADAPTER" "$_probe_eadp"
        [[ -n "$_probe_eurl" ]] && _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_EMBEDDER_URL"     "$_probe_eurl"
        if [[ -n "$_probe_emdl" ]]; then
            # gguf_ffi reads its .gguf path from MEMO_GGUF_MODEL; the env→config
            # bootstrap maps MEMO_EMBEDDER_MODEL only for HTTP embedders.
            if [[ "$_probe_eloc" == "gguf_ffi" ]]; then
                _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_GGUF_MODEL"     "$_probe_emdl"
            else
                _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_EMBEDDER_MODEL" "$_probe_emdl"
            fi
        fi
        _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_EMBED_DIM" "$_probe_embed_dim"
        [[ -n "$_probe_emxc" ]] && _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_EMBED_MAX_CHARS"  "$_probe_emxc"
        # Self-maintaining memory: a debounced digest piggybacks on writes so tier
        # promotion / consolidation / decay run without any agent or scheduler
        # having to call `memo digest`. Write-if-absent, so an explicit 0 is kept.
        _save_rc_key_if_absent "$_MEMO_PROJECT_DIR/.luamemorc" "MEMO_AUTO_DIGEST" "1"
    fi
    # Re-read the project config so every later phase runs with what was just
    # persisted: the codebase scan must embed with the chosen embedder at its
    # dimension, and the MCP env must carry the model path / MEMO_EMBED_DIM.
    if [[ -f "$_MEMO_PROJECT_DIR/.luamemorc" ]]; then
        _load_project_rc || true
        local _relua; _relua=$(find_lua) && lua="$_relua"
    fi
    # An HTTP embedder that wants an API key: say how to give it one (the vault).
    if [[ -n "${MEMO_EMBEDDER_URL:-}" && "$dry_run" != true ]]; then
        _calibrate_embedder_auth "$lua"
    fi

    # ── Scope (auto-detected; the org link below records it too) ────────────
    if [[ -z "$scope" ]]; then
        if [[ -n "${MEMO_SCOPE:-}" ]]; then
            scope="$MEMO_SCOPE"
        else
            local remote; remote=$(git -C "$root" remote get-url origin 2>/dev/null || echo "")
            if [[ -n "$remote" ]]; then
                scope="repo:$(basename "$remote" .git)"
            else
                scope="repo:$(basename "$(cd "$root" && pwd)")"
            fi
        fi
    fi

    # ── Phase 2.6: federation (optional; needs the DB + schema) ─────────────
    if [[ "$role" == "org" ]]; then
        if [[ "$dry_run" == true ]]; then
            echo ""; echo "  [dry-run] Would configure this instance as org central org:${org_name}."
            return 0
        fi
        _calibrate_org_central "$lua" "$org_name"
        return $?   # a central has no per-dev phases (ingest, MCP, plugin)
    elif [[ -n "$org_url" ]]; then
        if [[ "$dry_run" == true ]]; then
            echo ""; echo "  [dry-run] Would join org central $(_redact_url "$org_url") as a dev."
        else
            _calibrate_org_dev "$lua" "$org_url" "$org_fingerprint" || true
        fi
    elif [[ "$role" == "solo" && "$dry_run" != true ]]; then
        _calibrate_org_leave "$lua"
    fi

    # ── Phase 3: ingest ─────────────────────────────────────────────────────
    echo ""
    echo "Ingesting codebase → scope: $scope"

    # Get last calibrated commit for incremental scanning (via KG)
    local since_sha=""
    since_sha=$(jq -n \
        --arg scope "$scope" \
        '{scope: $scope, subject: "calibrate", predicate: "last_commit", limit: 1}' \
        | api_call kg-query \
        | jq -r '(.results // []) | if type=="array" then .[0] else ."1" end | .object // empty' \
        2>/dev/null || echo "")
    [[ -n "$since_sha" ]] && echo "  (incremental: commits since ${since_sha:0:7})"

    # Build Lua flags for the scan phase
    local scan_args=(--scan --scope "$scope" --root "$root")
    [[ -n "$since_sha" ]] && scan_args+=(--since-commit "$since_sha")
    [[ "$no_git" == true      ]] && scan_args+=(--no-git)
    [[ "$no_comments" == true ]] && scan_args+=(--no-comments)

    # ── Phase 4: scan → write (single Lua process handles all writes) ────────
    local count=0 errors=0
    if [[ "$dry_run" == true ]]; then
        while IFS= read -r mem_line; do
            [[ -z "$mem_line" ]] && continue
            local title; title=$(printf '%s' "$mem_line" | jq -r '.title // "(no title)"' 2>/dev/null)
            echo "  [dry-run] $title"
            (( count++ )) || true
        done < <(_lua_run "$lua" calibrate "${scan_args[@]}")
        echo ""
        echo "  [dry-run] Would write $count memories. Re-run without --dry-run to apply."
    else
        while IFS= read -r result_line; do
            [[ -z "$result_line" ]] && continue
            local ok; ok=$(printf '%s' "$result_line" | jq -r '.ok // false' 2>/dev/null)
            if [[ "$ok" == "true" ]]; then
                (( count++ )) || true
            else
                (( errors++ )) || true
            fi
        done < <(
            _lua_run "$lua" calibrate "${scan_args[@]}" \
            | "$lua" -e "$_LUA_PATH_GUARD
require('luamemo.cli.api').dispatch('write-many')"
        )
        echo ""
        echo "  Done: $count memories written ($errors errors) to scope=$scope"
    fi

    # Update KG cursor so next calibrate only processes new commits
    if [[ "$dry_run" != true ]] && [[ "$no_git" != true ]]; then
        local head_sha; head_sha=$(git -C "$root" rev-parse HEAD 2>/dev/null || echo "")
        if [[ -n "$head_sha" ]]; then
            jq -n \
                --arg scope "$scope" \
                --arg sha "$head_sha" \
                '{scope: $scope, subject: "calibrate", predicate: "last_commit", object: $sha, supersede: true}' \
            | api_call kg-assert >/dev/null 2>&1 || true
        fi
    fi

    # ── Phase 5: IDE detection + MCP config ─────────────────────────────────
    if [[ "${no_mcp:-false}" != "true" ]]; then
        _calibrate_mcp_phase "$root" "$scope"
        # The clients that started luamemo here: one too old for something it needs is named.
        local _lua_c; _lua_c=$(find_lua) || _lua_c=""
        if [[ -n "$_lua_c" ]]; then
            echo ""
            "$_lua_c" -e "$_LUA_PATH_GUARD
local lines, ok = require('luamemo.clients').report()
for _, l in ipairs(lines) do print('  ' .. (ok and '' or 'WARNING: ') .. l) end" 2>/dev/null || true
        fi
    fi

    # ── Phase 6: VS Code agent plugin install ────────────────────────────────
    if [[ "${no_plugin:-false}" != "true" ]]; then
        _calibrate_plugin_phase
    fi

    # ── Cleanup: remove SETUP_CHECK on successful first-run ──────────────────
    if [[ "$dry_run" != true ]] && [[ -f "${root}/SETUP_CHECK" ]]; then
        rm -f "${root}/SETUP_CHECK"
        echo ""
        echo "  First-run complete: SETUP_CHECK removed."
    fi
}

# ---------------------------------------------------------------------------
# VS Code agent plugin installer (called from cmd_calibrate phase 6)
# ---------------------------------------------------------------------------

# Echoes both the stable and Insiders plugin directories (one per line).
# Calling uname once and building both paths avoids two subshell forks.
_plugin_dirs() {
    local _os; _os="$(uname -s 2>/dev/null)"
    local _base
    if [[ "$_os" == "Darwin" ]]; then
        _base="$HOME/Library/Application Support"
    else
        _base="${XDG_CONFIG_HOME:-$HOME/.config}"
    fi
    echo "$_base/Code/agentPlugins/github.com/kaio326/luamemo"
    echo "$_base/Code - Insiders/agentPlugins/github.com/kaio326/luamemo"
}

# Prints the manual-install instructions; shared by two branches below.
_plugin_manual_msg() {
    echo "  To install manually: in VS Code Chat run 'Chat: Install Plugin From Source'"
    echo "  URL: https://github.com/kaio326/luamemo"
}

_calibrate_plugin_phase() {
    if ! command -v git &>/dev/null; then
        echo "  [plugin] git not found — skipping plugin install."
        _plugin_manual_msg; return
    fi

    local _installed=false
    local _dir
    while IFS= read -r _dir; do
        # Guard against empty path (e.g. $HOME unset in some containers).
        [[ -n "$_dir" ]] || continue

        # Skip if the VS Code agentPlugins parent directory doesn't exist.
        # On headless servers without VS Code this will always be absent.
        local _parent; _parent="$(dirname "$(dirname "$(dirname "$_dir")")")" 
        [[ -d "$_parent" ]] || continue

        if [[ -d "$_dir/.git" ]]; then
            # Skip the network pull if the plugin was fetched less than 24 h ago.
            # Clamp _age to 999999 on clock skew (negative result) to force pull.
            local _fetch_head="$_dir/.git/FETCH_HEAD"
            local _age=999999
            if [[ -f "$_fetch_head" ]]; then
                local _now _mtime
                _now=$(date +%s 2>/dev/null) || _now=0
                _mtime=$(date -r "$_fetch_head" +%s 2>/dev/null) || _mtime=0
                _age=$(( _now - _mtime ))
                (( _age < 0 )) && _age=999999
            fi
            if (( _age < 86400 )); then
                echo "  [plugin] Plugin is current (last checked < 24h ago)."
            else
                echo "  [plugin] Updating plugin at ${_dir} ..."
                git -C "$_dir" pull --ff-only --quiet 2>/dev/null \
                    && echo "  [plugin] Plugin up to date." \
                    || echo "  [plugin] Update skipped (local changes or no network)."
            fi
        else
            echo "  [plugin] Installing luamemo VS Code plugin ..."
            mkdir -p "$(dirname "$_dir")"
            git clone --depth 1 --quiet \
                https://github.com/kaio326/luamemo "$_dir" 2>/dev/null \
                && echo "  [plugin] Installed. Reload VS Code (Developer: Reload Window) to activate." \
                || echo "  [plugin] Clone failed — check network or install manually via 'Chat: Install Plugin From Source'."
        fi
        _installed=true
    done < <(_plugin_dirs)

    if [[ "$_installed" == false ]]; then
        echo "  [plugin] VS Code not detected — skipping plugin install."
        _plugin_manual_msg
    else
        echo "  Tip: add \"chat.mcp.autoStart\": true to VS Code settings so the"
        echo "       MCP server starts automatically when VS Code opens."
    fi
}

# _confirm_yn <prompt> — prints "<prompt> [y/N] ", reads an answer, returns
# 0 (true) for y/Y, 1 (false) otherwise. Under `set -e`, a bare `read` with
# no data available on stdin (a script, CI, or an agent's shell tool — no
# TTY) fails and silently kills the whole calibrate run with no error message
# and no clue why; guard with a TTY check and treat non-interactive as "no",
# printing a note so the skip is visible instead of a silent, unexplained
# truncation of the run.
_confirm_yn() {
    echo -n "  $1 [y/N] "
    if [[ ! -t 0 ]]; then
        echo "(non-interactive: skipping)"
        return 1
    fi
    local ans; read -r ans
    [[ "$ans" =~ ^[Yy]$ ]]
}

# _calibrate_embedder_auth <lua> — the configured HTTP embedder refuses requests
# (401 / 403): it wants an API key. The key goes into the vault, typed by the person
# at the terminal, and the header refers to it — it is never written to .luamemorc.
# Prints how; offers to do it when someone is at the terminal.
_calibrate_embedder_auth() {
    local lua="$1" out rc=0
    out=$(_lua_run "$lua" ping --embedder 2>&1) || rc=$?
    [[ $rc -ne 0 ]] || return 0
    local code; code=$(grep -oE 'HTTP 40[13]' <<<"$out" | head -1) || true
    [[ -n "$code" ]] || return 0
    local name="embedder-api-key" header
    header=$(jq -cn --arg n "$name" '{"Authorization": ("Bearer {secret:" + $n + "}")}')
    echo ""
    echo "  The embedder refused the request (${code}) — it needs an API key. Keep the key in"
    echo "  luamemo's vault (encrypted) and point the header at it:"
    echo "    memo secret-store ${name}"
    echo "    memo config set MEMO_EMBEDDER_HEADERS '${header}'"
    echo "  (a provider that wants another header — x-api-key, api-key — takes {secret:${name}} the same way)"
    _confirm_yn "Store the API key now?" || return 0
    local sout
    if ! sout=$(cmd_secret_store "$name" --desc "API key of the embedder at ${MEMO_EMBEDDER_URL:-}"); then
        echo "  Not stored: $(jq -r '.error // .' <<<"$sout" 2>/dev/null)"
        return 0
    fi
    cmd_config set MEMO_EMBEDDER_HEADERS "$header" >/dev/null || return 0
    _load_project_rc || true
    if _lua_run "$lua" ping --embedder >/dev/null 2>&1; then
        echo "  Stored — the embedder answers now."
    else
        echo "  Stored, but the embedder still refuses — check the key (memo secret-store ${name} replaces it)."
    fi
}

# An entry that starts mcp/server.lua itself, or passes MEMO_* settings / an envFile —
# what calibrate wrote before `memo mcp`: replaced with the generic entry.
_MCP_OLD_STYLE='((.args // []) | any(type == "string" and test("mcp/server\\.lua$")))
    or ((.env // {}) | keys | any(startswith("MEMO_"))) or (has("envFile"))'

# _mcp_put <file> <root: servers|mcpServers> <key> <entry json> <label> [old key]
# Writes the luamemo entry into a client's config (asking first). An old-style luamemo
# entry under <key> or <old key> is replaced; an entry of the user's own is kept.
_mcp_put() {
    local file="$1" root="$2" key="$3" entry="$4" label="$5" old_key="${6:-}"
    if [[ ! -f "$file" ]]; then
        if _confirm_yn "Create ${label} with the luamemo entry?"; then
            mkdir -p "$(dirname -- "$file")"
            jq -n --arg r "$root" --arg k "$key" --argjson e "$entry" '{($r): {($k): $e}}' > "$file"
            echo "  Created: $file"
        fi
        return 0
    fi
    local cur old=""
    cur=$(jq -c --arg r "$root" --arg k "$key" '.[$r][$k] // empty' "$file" 2>/dev/null) || {
        echo "  ${label}: not valid JSON — left as it is. Add the entry below by hand."
        return 0
    }
    if [[ -n "$old_key" && "$old_key" != "$key" ]]; then
        old=$(jq -c --arg r "$root" --arg k "$old_key" \
            ".[\$r][\$k] // empty | select($_MCP_OLD_STYLE)" "$file" 2>/dev/null) || old=""
    fi
    if [[ -n "$cur" && -z "$old" && "$(jq -cS . <<<"$cur")" == "$(jq -cS . <<<"$entry")" ]]; then
        echo "  ${label}: luamemo entry up to date."
        return 0
    fi
    if [[ -n "$cur" ]] && ! jq -e "$_MCP_OLD_STYLE" >/dev/null 2>&1 <<<"$cur"; then
        echo "  ${label}: a luamemo entry of your own is there — kept."
        return 0
    fi
    local q="Write the luamemo entry to ${label}?"
    [[ -n "$cur$old" ]] && q="Replace the old-style luamemo entry in ${label} (a server path + MEMO_* settings) with the generic one (memo mcp)?"
    if _confirm_yn "$q"; then
        local updated
        updated=$(jq --arg r "$root" --arg k "$key" --arg o "$old_key" --argjson e "$entry" \
            '(if $o != "" and $o != $k then .[$r] |= del(.[$o]) else . end) | .[$r][$k] = $e' "$file") || return 1
        printf '%s\n' "$updated" > "$file"
        echo "  Updated: $file"
    fi
}

# _calibrate_save_shell_settings <lua> — an MCP client starts the server without this
# shell's environment: a setting the MCP server needs that only the shell sets (the
# database, embedder, org settings — the registry's mcp_env ones) is offered for the
# project's .luamemorc.
_calibrate_save_shell_settings() {
    local lua="$1" names name
    names=$(MEMO__PROJECT_DIR="$_MEMO_PROJECT_DIR" "$lua" -e "$_LUA_PATH_GUARD
local s = require('luamemo.settings')
local f = s.files()
for _, e in ipairs(s.LIST) do
    local v = os.getenv(e.env)
    if e.mcp_env and v and v ~= '' and not f.project[e.env] and not f.user[e.env] then print(e.env) end
end" 2>/dev/null) || return 0
    for name in $names; do
        if _confirm_yn "${name} is set only in this shell — save it in .luamemorc (MCP clients don't get your shell's settings)?"; then
            cmd_config set "$name" "${!name}" >/dev/null && echo "  Saved ${name} in ${_MEMO_PROJECT_DIR}/.luamemorc"
        fi
    done
}

# ---------------------------------------------------------------------------
# IDE detection + MCP config writer (called from cmd_calibrate phase 5)
# ---------------------------------------------------------------------------
_calibrate_mcp_phase() {
    local root="$1" scope="$2"
    local lua_bin; lua_bin=$(find_lua) || lua_bin="luajit"
    local self; self=$(_memo_self_path)

    echo ""
    echo "MCP client configuration"
    echo "========================"
    if ! _memo_server_path >/dev/null; then
        echo "  WARNING: mcp/server.lua not found next to $self or in a LuaRocks tree —"
        echo "  memo mcp can't start the server until luamemo is reinstalled (luarocks install luamemo)."
    fi
    if [[ "${dry_run:-false}" == true ]]; then
        echo "  [dry-run] No client config or setting written. The entry, for any client:"
        echo ""
        _mcp_print_config "" | sed 's/^/  /'
        echo ""
        return 0
    fi
    _calibrate_save_shell_settings "$lua_bin"

    # Every entry starts `memo mcp`, which reads the project's .luamemorc: nothing in it
    # but memo's path and, where the client has a workspace variable, the project.
    # Calibrate before `memo mcp` named an entry per project after the scope
    # (luamemo-<scope>) and filled it with MEMO_* settings: such an entry is replaced.
    local old_key="luamemo"
    if [[ -n "${scope:-}" ]]; then
        local _safe; _safe=$(printf '%s' "$scope" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')
        [[ -n "$_safe" ]] && old_key="luamemo-${_safe}"
    fi
    local ws_entry desktop_entry
    ws_entry=$(jq -cn --arg c "$self" '{"command":$c,"args":["mcp","--project","${workspaceFolder}"]}')
    desktop_entry=$(jq -cn --arg c "$self" --arg p "$root" '{"command":$c,"args":["mcp","--project",$p]}')

    # ── VS Code (.vscode/mcp.json, this workspace) ──────────────────────────
    if [[ -d "${root}/.vscode" ]]; then
        echo "  Detected: VS Code workspace (.vscode/ found)"
        _mcp_put "${root}/.vscode/mcp.json" servers luamemo "$(jq -c '{"type":"stdio"} + .' <<<"$ws_entry")" \
            ".vscode/mcp.json" "$old_key"
    fi
    # ── Cursor (~/.cursor/mcp.json: every project — the workspace variable names it) ──
    if [[ -d "${HOME}/.cursor" ]]; then
        echo "  Detected: Cursor (~/.cursor/ found)"
        _mcp_put "${HOME}/.cursor/mcp.json" mcpServers luamemo "$ws_entry" "~/.cursor/mcp.json" "$old_key"
    fi
    # ── Claude Desktop (no workspace: one entry per project, its folder pinned) ──
    local claude_cfg="${HOME}/.config/Claude/claude_desktop_config.json"
    [[ "$(uname)" == "Darwin" ]] && claude_cfg="${HOME}/Library/Application Support/Claude/claude_desktop_config.json"
    if [[ -f "$claude_cfg" ]]; then
        echo "  Detected: Claude Desktop (${claude_cfg})"
        local dkey="$old_key"; [[ "$dkey" == "luamemo" ]] && dkey="luamemo-$(basename -- "$root" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//')"
        _mcp_put "$claude_cfg" mcpServers "$dkey" "$desktop_entry" "claude_desktop_config.json" "$old_key"
    fi

    # ── Any client: the entry, always ───────────────────────────────────────
    echo ""
    _mcp_print_config "" | sed 's/^/  /'
    echo "  (Claude Code with the luamemo plugin needs nothing: the plugin starts memo mcp.)"
    echo "  More clients: README.md → Connect any MCP client."
    echo ""
}

# _memo_server_path → the absolute path of the mcp/server.lua that belongs with this
# memo (exit 1 when none is found). In order:
#   1. next to this script — a dev clone or the plugin (<root>/cli/memo → <root>/mcp);
#   2. the rock tree of the prefix memo is installed in (<prefix>/bin/memo →
#      <prefix>/lib/luarocks/rocks-5.1/luamemo/<version>/mcp) — fast, no luarocks call;
#   3. `luarocks show luamemo` — the prefix luarocks installed it in;
#   4. the usual LuaRocks trees (~/.luarocks, /usr/local, /usr).
# Among installed versions, the newest.
_memo_server_path() {
    local script_dir; script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local rel="$script_dir/../mcp/server.lua" srv="" lr prefix
    if [[ -f "$rel" ]]; then
        srv=$(cd "$script_dir/../mcp" && pwd)/server.lua
        printf '%s' "$srv"; return 0
    fi
    _memo_rock_server() {
        [[ -d "$1/lib/luarocks" ]] || return 1
        { find "$1/lib/luarocks" -maxdepth 8 -path "*/luamemo/*/mcp/server.lua" 2>/dev/null || true; } \
            | sort -V | tail -1
    }
    srv=$(_memo_rock_server "$script_dir/..") || srv=""
    if [[ -z "$srv" ]]; then
        for lr in luarocks-5.1 luarocks; do
            command -v "$lr" >/dev/null 2>&1 || continue
            prefix=$("$lr" show luamemo 2>/dev/null | grep -i "installed in:" | head -1 \
                | sed 's/.*[Ii]nstalled in:[[:space:]]*//')
            [[ -n "$prefix" ]] && { srv=$(_memo_rock_server "$prefix") || srv=""; break; }
        done
    fi
    if [[ -z "$srv" ]]; then
        for prefix in "$HOME/.luarocks" /usr/local /usr; do
            srv=$(_memo_rock_server "$prefix") || srv=""
            [[ -n "$srv" ]] && break
        done
    fi
    [[ -n "$srv" && -f "$srv" ]] || return 1
    srv=$(cd "$(dirname -- "$srv")" && pwd)/server.lua
    printf '%s' "$srv"
}

# memo's own absolute path, as invoked (a symlink stays a symlink: an upgrade that
# moves the files it points to keeps working) — for client configs: a GUI app may
# not have the user's PATH.
_memo_self_path() {
    printf '%s/%s' "$(cd "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" "$(basename -- "${BASH_SOURCE[0]}")"
}

# memo mcp [--project PATH] [--print-config]: the MCP stdio server, with this
# project's settings (read above, like every memo command — the client's config needs
# no MEMO_* environment). --print-config: the client entry that starts it.
cmd_mcp() {
    local print=false project=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project) project="${2:?--project needs a directory}"; shift 2 ;;
            --print-config) print=true; shift ;;
            -h|--help)
                cat <<'EOF'
Usage: memo mcp [--project PATH] [--print-config]

Runs the luamemo MCP server over stdio — the command an MCP client starts. The settings
are the project's (its .luamemorc, over ~/.luamemorc), found like every memo command:
--project PATH, else the nearest directory from the client's working directory up that
holds a .luamemorc. The client's config needs no MEMO_* environment (nothing secret).

  --project PATH   the project (e.g. VS Code: ${workspaceFolder})
  --print-config   print the client entry that starts this server, and exit
EOF
                return 0 ;;
            *) echo "memo mcp: unknown option: $1 (memo mcp --help)" >&2; return 2 ;;
        esac
    done
    if [[ "$print" == true ]]; then
        _mcp_print_config "$project"
        return 0
    fi
    local lua; lua=$(find_lua) || _no_lua
    local server; server=$(_memo_server_path) || {
        echo "memo mcp: mcp/server.lua not found next to $(_memo_self_path) or in a LuaRocks tree" \
            "— reinstall luamemo (luarocks install luamemo)" >&2
        exit 1
    }
    # The settings are in the environment already (memo read the .luamemorc files):
    # the server doesn't read them a second time.
    MEMO__SETTINGS_LOADED=1 exec "$lua" "$server"
}

# _mcp_print_config [PROJECT] — the generic client entries for `memo mcp`.
_mcp_print_config() {
    require_jq
    local project="$1" self; self=$(_memo_self_path)
    local args='["mcp"]' vsargs='["mcp","--project","${workspaceFolder}"]' cli_args=(mcp)
    if [[ -n "$project" ]]; then
        project=$(cd "$project" 2>/dev/null && pwd) || project="$1"
        args=$(jq -cn --arg p "$project" '["mcp","--project",$p]'); vsargs="$args"
        cli_args=(mcp --project "$project")
    fi
    echo "luamemo in an MCP client — the same entry everywhere; nothing secret in it (memo mcp"
    echo "reads the project's .luamemorc)."
    echo ""
    echo "Most clients (Claude Desktop, Claude Code's .mcp.json, Cursor, Windsurf…) — \"mcpServers\":"
    jq -n --arg c "$self" --argjson a "$args" '{"mcpServers":{"luamemo":{"command":$c,"args":$a}}}'
    echo ""
    echo "VS Code (.vscode/mcp.json or the user's mcp.json) — \"servers\":"
    jq -n --arg c "$self" --argjson a "$vsargs" '{"servers":{"luamemo":{"type":"stdio","command":$c,"args":$a}}}'
    echo ""
    echo "Claude Code from the terminal:"
    printf '  claude mcp add luamemo -s user --'
    printf ' %q' "$self" "${cli_args[@]}"
    printf '\n\n'
    if [[ -n "$project" ]]; then
        echo "The project: $project (--project)."
    else
        echo "The project: the nearest directory from the client's working directory up that holds a"
        echo ".luamemorc (memo calibrate writes it) — or pass --project PATH in \"args\"."
    fi
}

# memo gguf [status | install]: the in-process GGUF embedder's runtime (luamemo.cli.gguf).
# install downloads this release's prebuilt one and records it for every project
# (MEMO_GGUF_SHIM in ~/.luamemorc).
cmd_gguf() {
    local lua; lua=$(find_lua) || _no_lua
    if [[ "${1:-status}" != install ]]; then _lua_run "$lua" gguf "$@"; return $?; fi
    local out rc=0 shim
    out=$(_lua_run "$lua" gguf install 2>&1) || rc=$?
    printf '%s\n' "$out" | grep -v '^SHIM '
    [[ $rc -eq 0 ]] || return $rc
    shim=$(printf '%s\n' "$out" | sed -n 's/^SHIM //p' | tail -1)
    [[ -n "$shim" ]] || return 1
    cmd_config set --user MEMO_GGUF_SHIM "$shim" >/dev/null && export MEMO_GGUF_SHIM="$shim" \
        && echo "  MEMO_GGUF_SHIM=$shim recorded in ~/.luamemorc (every project)."
}

# _calibrate_gguf_runtime <lua> — calibrate's offer of the prebuilt runtime (above).
_calibrate_gguf_runtime() {
    local lua="$1" offer
    offer=$("$lua" -e "$_LUA_PATH_GUARD
local shim = require('luamemo.embedders.native.ffi_shim').shim_path()
local f = io.open(shim, 'rb'); if f then f:close(); return end
local b = require('luamemo.embedders.native.bundle').available()
if b then io.write(b.platform, ' ', b.asset) end" 2>/dev/null) || offer=""
    [[ -n "$offer" ]] || return 0
    echo ""
    echo "GGUF runtime: this release has a prebuilt in-process embedder runtime for ${offer%% *}"
    echo "  (${offer#* }, from github.com/kaio326/luamemo/releases; checked against the checksum"
    echo "  in this install) — no compiler or llama.cpp build needed."
    if _confirm_yn "Download and install it?"; then
        cmd_gguf install || echo "  Not installed — the embedder recommendation below doesn't use it."
    fi
}

cmd_local_lua() {
    local module="$1"; shift
    local lua; lua=$(find_lua) || _no_lua
    # exec: signals (e.g. SIGTERM to a `memo serve` daemon) reach Lua directly.
    # Consequence: this must be the LAST command of its caller — nothing after it
    # runs. Mid-function callers (e.g. calibrate) use _lua_run instead.
    MEMO__ARGV="$(_lua_argv "$@")" MEMO__MODULE="$module" exec "$lua" -e "$_LUA_RUN"
}

# memo config …: luamemo.cli.config does the work; a setting it wrote into the
# project's .luamemorc keeps that file out of git (it holds this machine's settings).
cmd_config() {
    local lua; lua=$(find_lua) || _no_lua
    local rc=0 a user=false
    for a in "$@"; do [[ "$a" == "--user" ]] && user=true; done
    MEMO__PROJECT_DIR="$_MEMO_PROJECT_DIR" _lua_run "$lua" config "$@" || rc=$?
    if [[ $rc -eq 0 && "${1:-}" == "set" && "$user" == false && -f "$_MEMO_PROJECT_DIR/.luamemorc" ]]; then
        _gitignore_local "$_MEMO_PROJECT_DIR" ".luamemorc"
    fi
    return $rc
}

usage() {
    awk 'NR>1 && /^[^#]/{exit} NR>1{sub(/^# ?/,""); print}' "$0"
    exit 0
}

[[ $# -lt 1 ]] && usage
sub="$1"; shift

case "$sub" in
    write)  cmd_write  "$@" ;;
    search) cmd_search "$@" ;;
    recent) cmd_recent "$@" ;;
    get)    cmd_get    "$@" ;;
    update) cmd_update "$@" ;;
    delete) cmd_delete "$@" ;;
    summarize) cmd_summarize "$@" ;;
    promote) cmd_promote "$@" ;;
    context) cmd_context "$@" ;;
    kg)     cmd_kg     "$@" ;;
    embed)  cmd_embed  "$@" ;;
    tune-weights) cmd_tune_weights "$@" ;;
    brief)  cmd_brief   "$@" ;;
    consolidate) cmd_consolidate "$@" ;;
    digest) cmd_digest "$@" ;;
    sense)  cmd_sense  "$@" ;;
    learn)  cmd_learn  "$@" ;;
    reembed) cmd_reembed "$@" ;;
    index)     cmd_local_lua index "$@" ;;
    calibrate) cmd_calibrate "$@" ;;
    setup)     cmd_setup     "$@" ;;
    secret-store)   cmd_secret_store   "$@" ;;
    secret-list)    cmd_secret_list         ;;
    secret-delete)  cmd_secret_delete  "$@" ;;
    secret-execute) cmd_secret_execute "$@" ;;
    config)  cmd_config "$@" ;;
    mcp)     cmd_mcp "$@" ;;
    gguf)    cmd_gguf "$@" ;;
    backup)  cmd_local_lua backup "$@" ;;
    export)  cmd_local_lua export "$@" ;;
    import)  cmd_local_lua import "$@" ;;
    serve)   cmd_local_lua serve "$@" ;;
    org)     cmd_local_lua org "$@" ;;
    ping)
        # Show which config file named the database (MEMO_DB) so the user knows
        # which one is checked — critical when multiple projects are present.
        case "${_MEMO_CONFIG_SOURCE:-}" in
            local)  echo "[INFO] config: $_MEMO_PROJECT_DIR/.luamemorc" ;;
            global) echo "[WARN] config: ~/.luamemorc (every project's — no .luamemorc names a database here)" ;;
            *)      echo "[INFO] config: environment" ;;
        esac
        cmd_local_lua ping "$@" ;;
    doctor)  cmd_local_lua doctor "$@" ;;
    -h|--help|help) usage ;;
    *) echo "memo: unknown subcommand: $sub" >&2; usage ;;
esac