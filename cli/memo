# memo kg assert|query|invalidate|timeline — the knowledge graph: facts
# (subject, predicate, object) that hold from valid_from until invalidated, one
# scope at a time (default $MEMO_SCOPE). The flags mirror luamemo.kg; timestamps
# are ISO 8601 or epoch seconds.
cmd_kg() {
    require_jq
    local action="${1:-}"
    case "$action" in
        assert|query|invalidate|timeline) shift ;;
        *)
            echo "usage: memo kg assert     --subject S --predicate P --object O [--valid-from T]" >&2
            echo "                          [--source-memory ID] [--supersede] [--scope SCOPE]" >&2
            echo "       memo kg query      [--subject S] [--predicate P] [--object O] [--at T]" >&2
            echo "                          [--include-invalidated] [--limit N] [--scope SCOPE]" >&2
            echo "       memo kg invalidate --subject S --predicate P [--object O] [--at T] [--scope SCOPE]" >&2
            echo "       memo kg timeline   --subject S --predicate P [--scope SCOPE]" >&2
            exit 2 ;;
    esac
    local json key
    json=$(jq -n --arg s "${MEMO_SCOPE:-}" 'if $s == "" then {} else {scope: $s} end')
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope|--subject|--predicate|--object|--valid-from|--at|--limit|--source-memory)
                [[ $# -ge 2 ]] || { echo "memo kg: $1 needs a value" >&2; exit 2; }
                key="${1#--}"; key="${key//-/_}"
                [[ "$key" == "source_memory" ]] && key="source_memory_id"
                json=$(jq --arg k "$key" --arg v "$2" '. + {($k): $v}' <<<"$json"); shift 2 ;;
            --supersede|--include-invalidated)
                key="${1#--}"; key="${key//-/_}"
                json=$(jq --arg k "$key" '. + {($k): true}' <<<"$json"); shift ;;
            *) echo "memo kg: unknown flag: $1" >&2; exit 2 ;;
        esac
    done
    local out; out=$(printf '%s' "$json" | api_call "kg-${action}")
    jq . <<<"$out"
    jq -e '.ok == true' <<<"$out" >/dev/null
}

# memo brief [--scope SCOPE]
# Print a tiny session-start digest (memory + codebase-map status + tool hints).
# No query required. Defaults --scope to $MEMO_SCOPE. Never fails the caller —
# designed to be run from a SessionStart hook and injected into the session.
cmd_brief() {
    require_jq
    local scope="${MEMO_SCOPE:-}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --scope) scope="$2"; shift 2 ;;
            *) shift ;;   # ignore unknown args to stay robust in hook contexts
        esac
    done

    local json; json=$(jq -n --arg scope "$scope" \
        '{} | if $scope != "" then . + {scope: $scope} else . end')

    local lua; lua=$(find_lua) || return 0

    # Hard cap: a session-start hook must never block. If the DB is slow or
    # unreachable and the query hangs, `timeout` kills it and we print nothing.
    # -k 2: if the process ignores SIGTERM (e.g. blocked in a socket syscall),
    # SIGKILL it 2s later so no orphan lua process lingers after the hook.
    local runner=""
    command -v timeout >/dev/null 2>&1 && runner="timeout -k 2 ${MEMO_BRIEF_TIMEOUT:-5}"
    local result; result=$(printf '%s' "$json" | $runner "$lua" -e \
        "$_LUA_PATH_GUARD
require('luamemo.cli.api').dispatch('brief')" \
        2>/dev/null) || true
    local text; text=$(printf '%s' "$result" | jq -r '.text // empty' 2>/dev/null) || true
    [[ -n "$text" ]] && printf '%s\n' "$text"
    return 0
}

