cmd_secret_store() {
    require_jq
    local name="" desc="" file=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --desc)  desc="$2";  shift 2 ;;
            --file)  file="$2";  shift 2 ;;
            -*)  echo "memo secret-store: unknown flag: $1" >&2; exit 1 ;;
            *)   name="$1"; shift ;;
        esac
    done
    if [[ -z "$name" ]]; then
        echo "Usage: memo secret-store NAME [--desc DESCRIPTION] [--file PATH]" >&2
        exit 1
    fi
    local value
    if [[ -n "$file" ]]; then
        value=$(cat "$file")
    else
        read -r -s -p "Secret value for \"${name}\": " value
        echo >&2
    fi
    if [[ -z "$value" ]]; then
        echo "memo secret-store: value cannot be empty" >&2
        exit 1
    fi
    # The value goes to jq on stdin (printf is a builtin: no process carries it), never as an
    # argument — a command line is readable by any local user (ps, /proc/<pid>/cmdline).
    local body; body=$(printf '%s' "$value" | jq -Rs \
        --arg n "$name" \
        --arg d "$desc" \
        '{name: $n, value: ., description: (if $d == "" then null else $d end)}')
    value=""
    local out; out=$(printf '%s' "$body" | api_call secret-store)
    body=""
    jq 'if .ok then {ok, secret: {name: .secret.name, description: .secret.description}} else . end' <<<"$out"
    jq -e '.ok == true' <<<"$out" >/dev/null
}

cmd_secret_list() {
    require_jq
    printf '{}' | api_call secret-list \
        | jq 'if .ok then [.secrets[] | {name, description, used_count, last_used_at, updated_at}] else . end'
}

cmd_secret_delete() {
    require_jq
    if [[ -z "${1:-}" ]]; then
        echo "Usage: memo secret-delete NAME" >&2; exit 1
    fi
